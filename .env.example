# Copy this file to .env and fill in every value.
# Use letters and numbers only in passwords (no quotes, spaces or $ signs).
# Never commit .env to GitHub; .gitignore already excludes it.

# Postgres superuser. n8n also uses this account for its own internal database.
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=n8n

# Password for lead_router_app, the limited user that owns the lead_router database.
# You will type this into the n8n "Lead Router - Postgres" credential.
LEAD_ROUTER_DB_PASSWORD=replace-with-another-long-random-password

# Encrypts the credentials n8n saves. Generate one in Terminal with:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-the-output-of-openssl-rand-hex-32

GENERIC_TIMEZONE=America/New_York
