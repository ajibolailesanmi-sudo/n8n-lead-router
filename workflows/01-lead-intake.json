              "fieldOptions": {
                "values": [
                  {
                    "option": "United States"
                  },
                  {
                    "option": "Canada"
                  },
                  {
                    "option": "United Kingdom"
                  },
                  {
                    "option": "Other"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Company size (employees)",
              "fieldName": "company_size",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "1-10"
                  },
                  {
                    "option": "11-50"
                  },
                  {
                    "option": "51-200"
                  },
                  {
                    "option": "201-1000"
                  },
                  {
                    "option": "1000+"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Budget",
              "fieldName": "budget",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Under $5k"
                  },
                  {
                    "option": "$5k-$15k"
                  },
                  {
                    "option": "$15k-$50k"
                  },
                  {
                    "option": "$50k+"
                  },
                  {
                    "option": "Not sure"
                  }
                ]
              }
            },
            {
              "fieldLabel": "What do you need help with?",
              "fieldName": "service_interest",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Managed IT Support"
                  },
                  {
                    "option": "Cybersecurity"
                  },
                  {
                    "option": "Cloud Migration"
                  },
                  {
                    "option": "Microsoft 365 Setup"
                  },
                  {
                    "option": "IT Consulting"
                  },
                  {
                    "option": "Other"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Timeline",
              "fieldName": "timeline",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "ASAP"
                  },
                  {
                    "option": "1-3 months"
                  },
                  {
                    "option": "3-6 months"
                  },
                  {
                    "option": "Just researching"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Anything else we should know?",
              "fieldName": "message",
              "fieldType": "textarea"
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "path": "contact-sales",
          "appendAttribution": false,
          "buttonLabel": "Send",
          "ignoreBots": true,
          "customCss": ":root {\n  --color-submit-btn-bg: #1f3a5f;\n  --color-focus-border: #1f3a5f;\n  --color-header: #1f3a5f;\n  --color-required: #c0392b;\n  --font-size-header: 22px;\n}",
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Thanks! A specialist will contact you within one business day."
            }
          }
        }
